{
  "testRunner": "vitest",
  "tsconfigFile": "tsconfig.stryker.json",
  "appendPlugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "mutate": [
    "src/services/rate-service.ts",
    "src/services/usage-registration.ts",
    "src/services/secret-service.ts",
    "src/services/entitlements.ts",
    "src/plugins/entitlements.ts",
    "src/services/webhook-verification.ts",
    "src/services/permission-service.ts",
    "src/plugins/permissions.ts",
    "src/services/invitation-service.ts",
    "src/routes/organization-members.ts",
    "src/routes/admin/permissions.ts",
    "src/services/email/email-account-vault.ts",
    "src/services/email/email-account.service.ts",
    "src/services/email/email-dispatch.service.ts",
    "src/services/email/imap-client.ts",
    "src/services/email/smtp-client.ts",
    "src/lib/license-signing.ts",
    "src/lib/license-degradation.ts",
    "src/plugins/license.ts",
    "src/services/license-service.ts",
    "src/services/license-heartbeat-payload.ts",
    "src/services/license-client-state.ts",
    "src/routes/control/heartbeat.ts",
    "src/routes/control/licenses.ts",
    "src/routes/status.ts",
    "src/lib/rate-limiter.ts",
    "src/services/contract-otp-service.ts",
    "src/services/contract-service.ts",
    "src/lib/admin-passport.ts",
    "src/lib/admin-session.ts",
    "src/lib/signing-keys.ts",
    "src/lib/platform-admin.ts",
    "src/routes/control/admin-passport.ts",
    "src/routes/admin/sso.ts"
  ],
  "thresholds": {
    "high": 90,
    "low": 75,
    "break": null
  },
  "reporters": ["html", "clear-text", "progress"],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "concurrency": 4,
  "timeoutMS": 60000,
  "tempDirName": ".stryker-tmp"
}